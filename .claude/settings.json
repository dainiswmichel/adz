{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/phpcs-edited-file.sh\"",
            "timeout": 120,
            "statusMessage": "Checking WordPress Coding Standards"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/compliance-gate.sh\"",
            "timeout": 300,
            "statusMessage": "Running the compliance gate"
          }
        ]
      }
    ]
  }
}
