{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Atelier",
	"description": "Classy faded pastels. Pastels fail when they are only desaturated; they work when they share an undertone, so every accent here is mixed from the same clay and reads as a family. Warm paper, true ink, a serif for headings against a sans for text. No shadow anywhere: separation is carried by rule lines and open space, the way a printed page does it.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base",     "name": "Paper",  "color": "#faf6f0" },
				{ "slug": "contrast", "name": "Ink",    "color": "#2b2621" },
				{ "slug": "surface",  "name": "Card",   "color": "#fffdf9" },
				{ "slug": "accent-1", "name": "Rose",   "color": "#b5807c" },
				{ "slug": "accent-2", "name": "Sage",   "color": "#8d9c86" },
				{ "slug": "accent-3", "name": "Powder", "color": "#8fa4b8" },
				{ "slug": "accent-4", "name": "Clay",   "color": "#bb9268" }
			],
			"gradients": [
				{
					"slug": "rose-sage",
					"name": "Rose to sage",
					"gradient": "linear-gradient(135deg, #b5807c 0%, #bb9268 50%, #8d9c86 100%)"
				}
			]
		},
		"custom": {
			"adz": {
				"surface": "var(--wp--preset--color--surface)",
				"line": "color-mix(in oklab, var(--wp--preset--color--contrast) 14%, transparent)",
				"textQuiet": "color-mix(in oklab, var(--wp--preset--color--contrast) 62%, transparent)",
				"focus": "var(--wp--preset--color--accent-1)",
				"rule": "color-mix(in oklab, var(--wp--preset--color--contrast) 11%, transparent)",
				"ruleGap": "10px",
				"strokeInner": "color-mix(in oklab, var(--wp--preset--color--contrast) 18%, transparent)",
				"strokeMid": "color-mix(in oklab, var(--wp--preset--color--accent-4) 16%, transparent)",
				"strokeOuter": "color-mix(in oklab, var(--wp--preset--color--accent-2) 10%, transparent)",
				"ambience": "radial-gradient(70rem 46rem at 85% -10%, color-mix(in oklab, #b5807c 9%, transparent), transparent 70%)",
				"grainOpacity": "0.03",
				"grainBlend": "multiply",
				"edge": "linear-gradient(var(--wp--custom--adz--line), var(--wp--custom--adz--line))",
				"sheen": "none",
				"lift": "none"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": { "lineHeight": "1.68" },
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "500",
					"letterSpacing": "-0.012em"
				}
			},
			"link": { "color": { "text": "var(--wp--preset--color--accent-1)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				}
			}
		}
	}
}
